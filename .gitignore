# Rust
/target/
**/*.rs.bk

# Node
node_modules/
dist/
.vite/

# Tauri
/shell/gen/
/shell/target/

# Nix / direnv
/.direnv/
result
result-*

# Derived notmuch database — tests rebuild it from the .eml fixtures in a tempdir
fixtures/maildir/.notmuch/

# Visual regression: baselines are committed, the rest is per-run output.
screenshots/visual/current/
screenshots/visual/diff/

# Anything driven against real mail. These frames show a real inbox — and, in
# the composer's address completion, other people's addresses. They must never
# be committed. The verifiers that touch real mail all write here.
screenshots/live/

# Playwright's own per-run output. The specs are committed; traces are not.
web/test-results/
web/playwright-report/
web/blob-report/

# Local scratch
/screenshot*.png
/tmp.json
*.log
web/dist/

# Zola output; the site is built by CI and published to gh-pages.
docs/public/
docs/static/giallo-*.css

# Signing material. The real keystore lives outside the repository and is
# backed up in `pass` under `android/ecr/`; CI reconstructs a throwaway one
# from a secret. Nothing of the sort belongs in git — a release key that leaks
# cannot be rotated for anyone who already installed the app, and one that is
# lost means every install must be removed by hand before it can be upgraded.
*.jks
*.keystore
*.p12
keystore.properties
