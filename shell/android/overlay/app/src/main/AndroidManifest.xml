<?xml version="1.0" encoding="utf-8"?>
<!-- ecr's manifest. This replaces the one `cargo tauri android init` writes;
     shell/android/upstream/AndroidManifest.xml is a copy of that generated file
     as it stood when this was pinned, and scripts/android-overlay.sh diffs the
     two on every build so a Tauri template change cannot land unnoticed.

     What differs from the generated file, and why:

     - `networkSecurityConfig`. Everything else here is cosmetic; this one is
       the difference between the release APK working and not. The generated
       gradle sets `usesCleartextTraffic` false for release and true only for
       debug, and `just android` builds debug — so an APK that talks to
       http://host:8383 all through development cannot reach it once CI
       publishes a release build. See res/xml/network_security_config.xml.

     - Backup rules. The API token lives in the webview's localStorage, and
       `allowBackup` defaults to true, which puts it in Google's cloud backup.

     - No AndroidTV. The leanback feature and LEANBACK_LAUNCHER category are
       Tauri template defaults. This app is a phone client that hides its own
       keyboard hints below `md`; it has no business in a TV launcher.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13 and up. Requested at the moment mail actually arrives rather
         than on first launch: the notification is the reason to say yes, and a
         prompt that precedes anything to be notified about gets refused. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ecr_desktop"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offers ecr as a mail client. SENDTO is what other apps use when
                 they mean "write to this address"; VIEW is what a browser sends
                 for a mailto link in a page. Both arrive as an intent on this
                 activity, which is `singleTask`, so a second one reaches the
                 running instance through onNewIntent and the deep-link plugin
                 hands it to the shell.

                 There is no `<data android:host>`: a mailto URI has no host,
                 and adding one would silently match nothing. -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mailto" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
