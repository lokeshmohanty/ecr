<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and above; see backup_rules.xml for why none of this travels.
     `device-transfer` is excluded too: a phone-to-phone move is a friendlier
     path than a cloud backup, but it still copies the bearer token onto a
     device the server was never told about. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
