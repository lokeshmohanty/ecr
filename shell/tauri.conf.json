{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ecr",
  "version": "0.1.2",
  "identifier": "dev.lokeshmohanty.ecr",
  "build": {
    "beforeBuildCommand": "pnpm --dir web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ecr",
        "width": 1280,
        "height": 860,
        "minWidth": 480,
        "minHeight": 400,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http: https: ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "A keyboard-driven mail client for an existing notmuch maildir",
    "longDescription": "ecr is a mail client for a maildir that notmuch already indexes. A Rust server owns all the mail state and shells out to mbsync and msmtp; one client ships to the browser, the desktop and Android. It does not fetch, store or index mail itself.",
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/ecr.desktop",
        "files": {
          "/usr/share/metainfo/dev.lokeshmohanty.ecr.metainfo.xml": "../packaging/dev.lokeshmohanty.ecr.metainfo.xml",
          "/usr/share/doc/ecr/ecr.service": "../packaging/ecr.service"
        }
      }
    },
    "android": {
      "minSdkVersion": 28
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mailto"
        ]
      }
    }
  }
}
