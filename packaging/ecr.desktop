[Desktop Entry]
Type=Application
Name=ecr
GenericName=Mail Client
Comment=A keyboard-driven mail client for an existing notmuch maildir
Exec=ecr-desktop
# `ecr-desktop`, not `ecr`: Tauri names the entry it generates after
# `productName` but names the icons it installs after the *binary*, so the
# icons land in hicolor as `ecr-desktop.png` while the file beside them is
# `ecr.desktop`. linuxdeploy resolves this key against those icons and refuses
# to build an AppImage when nothing matches — `Could not find suitable icon for
# Icon entry` — which is how the first release broke. The deb does not check,
# so there it was only a launcher with no artwork. The Nix package installs the
# same name for the same reason.
Icon=ecr-desktop
Terminal=false
Categories=Network;Email;
Keywords=mail;email;notmuch;maildir;vim;
StartupNotify=true
# Declared because it is handled: the shell registers the `mailto` scheme with
# the deep-link plugin and opens the composer prefilled. Declaring it without
# that would make ecr offer itself as the system's mail client and then do
# nothing when chosen, which is worse than not offering.
MimeType=x-scheme-handler/mailto;
# X11 takes the WM class from the program name, which is the binary and not the
# product name — without this the running window does not match its own launcher
# entry and the shell draws a second, unnamed icon beside it.
#
# This file is Tauri's `desktopTemplate` for the deb and the AppImage, and is
# installed verbatim by the Nix package, so all three carry the same entry.
#
# Tauri renders it as a Handlebars template, comments included. Nothing here
# needs substituting, so there must be no handlebars expressions anywhere in
# the file — a comment that so much as names the brace syntax fails the build,
# which is exactly how the first release broke.
StartupWMClass=ecr-desktop
